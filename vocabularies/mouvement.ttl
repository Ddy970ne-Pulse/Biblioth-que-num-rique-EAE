@prefix mvt: <http://example.org/vocab/mouvement#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Vocabulaire personnalisé pour la bibliothèque numérique du mouvement.
#
# Avant import : remplacer l'URI de base "http://example.org/vocab/mouvement#"
# par un URI stable et réellement résolvable sous votre nom de domaine
# (ex. https://bibliotheque.votre-domaine.org/vocab/mouvement#), et mettre à
# jour ce fichier avant l'import dans Omeka S — l'URI du vocabulaire doit
# rester stable une fois des données créées avec, car les propriétés sont
# référencées par URI dans les items.
#
# Import : Admin Omeka S -> Contenu -> Vocabulaires -> Ajouter un vocabulaire
# -> Importer depuis un fichier (choisir ce fichier, format Turtle).

<http://example.org/vocab/mouvement#> a owl:Ontology ;
    rdfs:label "Vocabulaire du mouvement"@fr ;
    rdfs:comment "Vocabulaire personnalisé pour tracer l'histoire et l'évolution du message enseigné par le mouvement à travers ses études."@fr .

# ---------------------------------------------------------------------------
# Classes
# ---------------------------------------------------------------------------

mvt:Document a owl:Class ;
    rdfs:label "Document"@fr ;
    rdfs:comment "Classe abstraite regroupant toute ressource documentaire indexée (étude du mouvement ou article/ouvrage externe reproduit), pour permettre thème, période et liens précède/corrige communs aux deux."@fr .

mvt:Etude a owl:Class ;
    rdfs:subClassOf mvt:Document ;
    rdfs:label "Étude"@fr ;
    rdfs:comment "Une étude individuelle produite au sein du mouvement (enseignement propre du mouvement, par un de ses intervenants)."@fr .

mvt:ArticleOuvrage a owl:Class ;
    rdfs:subClassOf mvt:Document ;
    rdfs:label "Article / Ouvrage"@fr ;
    rdfs:comment "Document historique ou externe (sermon, manuscrit, article) dont l'auteur original est extérieur au mouvement, reproduit ou traduit intégralement par celui-ci (ex. sermon d'A.T. Jones, manuscrit d'Ellen G. White). Catégorie distincte de mvt:Etude : le contenu n'est pas un enseignement produit par le mouvement lui-même, même s'il est indexé comme pièce à part entière du corpus. L'assistant IA doit toujours signaler un extrait provenant de cette classe comme source historique/externe reproduite, jamais comme enseignement propre du mouvement."@fr .

mvt:Auteur a owl:Class ;
    rdfs:label "Auteur"@fr ;
    rdfs:comment "Personne ayant produit ou enseigné une étude."@fr .

mvt:Theme a owl:Class ;
    rdfs:label "Thème"@fr ;
    rdfs:comment "Thème abordé par une ou plusieurs études, organisable en arborescence."@fr .

mvt:Periode a owl:Class ;
    rdfs:label "Période"@fr ;
    rdfs:comment "Période ou phase d'enseignement identifiable dans l'histoire du mouvement."@fr .

mvt:LignePropetique a owl:Class ;
    rdfs:label "Ligne prophétique"@fr ;
    rdfs:comment "Ligne de réforme ou ligne cosmique servant de cadre à la lecture prophétique. Deux niveaux distincts attestés : (1) ligne cosmique chiasmique — Ligne d'Éden à Éden — englobant toute l'histoire humaine du péché originel à Éden restauré, avec la Loi du Dimanche comme pivot du chiasme ; (2) lignes dispensationnelles — Ligne de l'Humanité (aussi appelée ligne des 144 000, ligne unique post-2021), lignes des Prêtres/Lévites/Néthiniens (historiques, caduques comme méthodologie active), ligne des Millérites, ligne de Christ ; et lignes typologiques — ligne de l'Agriculture, ligne des Rois, ligne des Institutions (Actes 27). Toutes les lignes autres qu'Éden à Éden sont des segments, angles ou grilles de lecture au sein de cette ligne cosmique englobante."@fr .

mvt:BaliseTemporelle a owl:Class ;
    rdfs:label "Balise temporelle"@fr ;
    rdfs:comment "Balise ou marqueur prophétique daté servant de repère chronologique dans le déroulement des lignes. Balises attestées dans le corpus : 1798, 1844, 1863, 1888, 1989, 2001, 2014, 2016, 2020-2021, 2024, 2025, 2026 ; événements datés : 22 octobre 1844, 6 janvier 2021 (fin du 6ème royaume), 18 juillet 2024 (LD dispensationnelle), 20 janvier 2025, 3 janvier 2026 ; balises non datées : LD (Loi du Dimanche), FTG (Fin du Temps de Grâce), 2nde Venue."@fr .

mvt:Evenement a owl:Class ;
    rdfs:label "Événement de diffusion"@fr ;
    rdfs:comment "Type d'événement au cours duquel un enseignement a été délivré : Camp Meeting, Vêpres, IPR Meeting, ICM Meeting, Sabbath Meeting, Séminaire, Question & Réponse, Sabbat Zoom, Livrable, Newsletter."@fr .

mvt:Contexte a owl:Class ;
    rdfs:label "Contexte de diffusion"@fr ;
    rdfs:comment "Contexte géographique ou institutionnel de diffusion d'un enseignement : EAE France, EVE Guadeloupe, GCM (Guadeloupe Camp Meeting), IPR (Institute for Prophetic Research), TIN, ICM France, LGC (Le Grand Cri), PP Slovaquie, OL Brésil/Portugal, TMW, MPS Columbia, Tahiti, Ouganda-Jinja, Île de la Réunion, Fidji, Martinique."@fr .

# ---------------------------------------------------------------------------
# Propriétés — Document (Étude et Article/Ouvrage)
# ---------------------------------------------------------------------------

mvt:theme a rdf:Property ;
    rdfs:label "Thème"@fr ;
    rdfs:comment "Thème(s) abordé(s) par ce document."@fr ;
    rdfs:domain mvt:Document ;
    rdfs:range mvt:Theme .

mvt:periode a rdf:Property ;
    rdfs:label "Période"@fr ;
    rdfs:comment "Période d'enseignement à laquelle rattacher ce document."@fr ;
    rdfs:domain mvt:Document ;
    rdfs:range mvt:Periode .

mvt:messageCle a rdf:Property ;
    rdfs:label "Message clé"@fr ;
    rdfs:comment "Formulation courte du message enseigné dans cette étude sur le thème traité. Sert d'ancrage pour la recherche sémantique et le suivi d'évolution du message. Ne s'applique en pratique qu'à mvt:Etude — un mvt:ArticleOuvrage n'enseigne pas un message du mouvement, il en est une source."@fr ;
    rdfs:domain mvt:Etude .

mvt:precede a rdf:Property ;
    rdfs:label "Prolonge"@fr ;
    rdfs:comment "Lien vers un document antérieur (étude ou article/ouvrage) que celui-ci prolonge, précise ou complète — permet par exemple de lier une étude du mouvement à l'article/ouvrage externe sur lequel elle s'appuie."@fr ;
    rdfs:domain mvt:Document ;
    rdfs:range mvt:Document .

mvt:corrige a rdf:Property ;
    rdfs:label "Corrige"@fr ;
    rdfs:comment "Lien vers un document antérieur (étude ou article/ouvrage) dont celui-ci corrige ou nuance le contenu. Champ clé pour tracer l'évolution du message dans le temps."@fr ;
    rdfs:domain mvt:Document ;
    rdfs:range mvt:Document .

mvt:citationExterne a rdf:Property ;
    rdfs:label "Citation externe"@fr ;
    rdfs:comment "Référence à une source extérieure au mouvement, explicitement citée à l'intérieur d'une étude (mention ponctuelle, pas le document lui-même — voir mvt:ArticleOuvrage pour le cas où le document entier est d'origine externe). Seule catégorie de source externe que l'assistant IA de la bibliothèque est autorisé à restituer depuis une mvt:Etude, et toujours en la signalant comme telle."@fr ;
    rdfs:domain mvt:Etude .

mvt:ligne a rdf:Property ;
    rdfs:label "Ligne prophétique concernée"@fr ;
    rdfs:comment "Ligne(s) prophétique(s) à laquelle/auxquelles ce document se rapporte. Permet une navigation par ligne (ex. tous les documents concernant la Ligne d'Éden à Éden) et facilite le RAG à répondre à des questions sur une ligne précise sans confondre avec les autres."@fr ;
    rdfs:domain mvt:Document ;
    rdfs:range mvt:LignePropetique .

mvt:balise a rdf:Property ;
    rdfs:label "Balise temporelle mentionnée"@fr ;
    rdfs:comment "Balise(s) temporelle(s) mentionnée(s) dans ce document. Sert à retrouver rapidement toutes les études traitant d'une date-clé (ex. 18 juillet 2024, FTG, LD) et à pondérer la pertinence par balise dans le retrieval."@fr ;
    rdfs:domain mvt:Document ;
    rdfs:range mvt:BaliseTemporelle .

mvt:evenement a rdf:Property ;
    rdfs:label "Événement de diffusion"@fr ;
    rdfs:comment "Type d'événement au cours duquel le document a été délivré (Camp Meeting, Vêpres, IPR Meeting, etc.)."@fr ;
    rdfs:domain mvt:Document ;
    rdfs:range mvt:Evenement .

mvt:contexte a rdf:Property ;
    rdfs:label "Contexte géographique de diffusion"@fr ;
    rdfs:comment "Contexte géographique/institutionnel de diffusion (EAE France, EVE Guadeloupe, GCM, IPR, TIN, etc.)."@fr ;
    rdfs:domain mvt:Document ;
    rdfs:range mvt:Contexte .

mvt:visionType a rdf:Property ;
    rdfs:label "Type de vision prophétique"@fr ;
    rdfs:comment "Type de vision selon la doctrine attestée : chazon (vision panoramique, embrasse toute une ligne d'un coup), mareh (vision progressive/dispensationnelle, se déroule étape par étape). Attribut analytique optionnel utile pour distinguer les deux angles de lecture d'un même événement prophétique."@fr ;
    rdfs:domain mvt:Etude .

# ---------------------------------------------------------------------------
# Propriétés — Auteur
# ---------------------------------------------------------------------------

mvt:role a rdf:Property ;
    rdfs:label "Rôle"@fr ;
    rdfs:comment "Rôle de la personne au sein du mouvement (ex. fondateur, enseignant, intervenant)."@fr ;
    rdfs:domain mvt:Auteur .

# ---------------------------------------------------------------------------
# Propriétés — Thème
# ---------------------------------------------------------------------------

mvt:themeParent a rdf:Property ;
    rdfs:label "Thème parent"@fr ;
    rdfs:comment "Thème plus général dont celui-ci est un sous-thème, pour construire une arborescence de thèmes."@fr ;
    rdfs:domain mvt:Theme ;
    rdfs:range mvt:Theme .

# ---------------------------------------------------------------------------
# Propriétés — Ligne prophétique
# ---------------------------------------------------------------------------

mvt:ligneEnglobante a rdf:Property ;
    rdfs:label "Ligne englobante"@fr ;
    rdfs:comment "Ligne prophétique de niveau supérieur qui englobe celle-ci. Ex. : la Ligne de l'Humanité, les lignes des Prêtres/Lévites/Néthiniens, la ligne de Christ, la ligne des Millérites sont toutes englobées par la Ligne d'Éden à Éden (ligne cosmique)."@fr ;
    rdfs:domain mvt:LignePropetique ;
    rdfs:range mvt:LignePropetique .

mvt:ligneCaduque a rdf:Property ;
    rdfs:label "Ligne caduque comme méthodologie active"@fr ;
    rdfs:comment "Indique si cette ligne est caduque comme méthodologie ACTIVE (booléen). Ex. : lignes des Prêtres/Lévites/Néthiniens sont caduques post-2021 (FTG) selon Terrie 2025 — elles restent utiles rétrospectivement mais ne servent plus à se localiser dans le présent. La méthodologie active post-FTG est celle des dispensations et de la Ligne de l'Humanité (144K)."@fr ;
    rdfs:domain mvt:LignePropetique .

# ---------------------------------------------------------------------------
# Propriétés — Balise temporelle
# ---------------------------------------------------------------------------

mvt:baliseDate a rdf:Property ;
    rdfs:label "Date de la balise"@fr ;
    rdfs:comment "Date précise de la balise si connue (format ISO). Ex. : 1798, 1844-10-22, 2021-01-06, 2024-07-18, 2026-01-03. Certaines balises sont non-datées (LD, FTG, 2nde Venue)."@fr ;
    rdfs:domain mvt:BaliseTemporelle .

mvt:baliseLigne a rdf:Property ;
    rdfs:label "Ligne d'appartenance de la balise"@fr ;
    rdfs:comment "Ligne prophétique à laquelle cette balise appartient (ex. 22 octobre 1844 → Ligne des Millérites ; 18 juillet 2024 → Ligne de l'Humanité)."@fr ;
    rdfs:domain mvt:BaliseTemporelle ;
    rdfs:range mvt:LignePropetique .
