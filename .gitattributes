# Force LF (Unix) line endings for shell scripts and other files that must
# execute in Linux containers. Without this, Git on Windows may convert them
# to CRLF on checkout, breaking the Docker entrypoint with the classic
# "exec: no such file or directory" error on a file that visibly exists.

*.sh              text eol=lf
Dockerfile        text eol=lf
docker-compose.yml text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf

# Documentation and config files stay in their native format
*.md              text
*.txt             text
*.json            text
*.ttl             text

# Binary files - never touch
*.png             binary
*.jpg             binary
*.jpeg            binary
*.pdf             binary
*.zip             binary
*.gz              binary
