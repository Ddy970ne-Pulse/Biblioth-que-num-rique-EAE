# Copier ce fichier vers .env et renseigner les valeurs avant de lancer
# `docker compose up`.

# --- Base de données MySQL (Omeka S) ---
MYSQL_DATABASE=omeka
MYSQL_USER=omeka
MYSQL_PASSWORD=changez-moi
MYSQL_ROOT_PASSWORD=changez-moi-aussi

# --- Omeka S ---
# Version d'Omeka S à récupérer (tag GitHub, ex: v4.1.0). Voir
# https://github.com/omeka/omeka-s/releases pour la dernière version stable.
OMEKA_S_VERSION=v4.1.0
OMEKA_HTTP_PORT=8080

# --- Module AiLibrarian ---
# Clé API Anthropic — nécessaire pour activer les réponses sourcées par IA.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Clé API Voyage AI — fournisseur d'embeddings recommandé par Anthropic pour
# la recherche sémantique. Laisser vide pour utiliser le repli local
# (LocalHashEmbeddingProvider, qualité de recherche dégradée, à ne pas
# utiliser en production).
VOYAGE_API_KEY=
